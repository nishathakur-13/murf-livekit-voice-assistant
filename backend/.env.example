# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# For Groq: get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Agmarknet / data.gov.in (Mandi price lookup — Day 5)
# Get a free key from https://data.gov.in/user/register
# If not set, the agent falls back to the public demo key (rate-limited).
# -----------------------------------------------------------------------------
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# -----------------------------------------------------------------------------
# Day 6 — Outbound telephony via Linphone SIP (free, no Twilio needed)
#
# Step 1: Download Linphone app on your phone: https://linphone.org/en/
# Step 2: Create a free account at: https://subscribe.linphone.org/
#         You get a SIP address like: yourname@sip.linphone.org
# Step 3: Log into the Linphone app with your credentials.
# Step 4: Fill in the 3 variables below and save .env.local
# Step 5: Start the agent: uv run python src/agent.py start
# Step 6: Trigger a call: uv run python src/outbound_call.py
# -----------------------------------------------------------------------------

# Your Linphone username (just the part before @sip.linphone.org)
LINPHONE_USERNAME=yourlinphoneusername

# Your Linphone account password
LINPHONE_PASSWORD=yourlinphonepassword

# Your full Linphone SIP address (the agent will call this)
LINPHONE_SIP_ADDRESS=yourlinphoneusername@sip.linphone.org

# -----------------------------------------------------------------------------
# Day 7 — Human Escalation via Discord Webhook
#
# Step 1: Open Discord and go to your server (or create one)
# Step 2: Go to a channel → Settings → Integrations → Webhooks → New Webhook
# Step 3: Copy the Webhook URL and paste it below
# Format: https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYYYYYY
# If not set, escalations are still stored locally but NOT sent to Discord.
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token